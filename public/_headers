# Cloudflare Pages: how long phones may keep each kind of file before checking for a new copy.
# The page itself (index.html) isn't listed, so it's always checked and updates show up straight away.

# The app's code, styles and sounds: their names change whenever they change, so keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Faces, cards, logo, icons and fonts keep their names, so keep them a day and refresh in the background.
/avatars/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
